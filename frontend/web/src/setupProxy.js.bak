const { createProxyMiddleware } = require('http-proxy-middleware');
const fs = require('fs');
const path = require('path');

module.exports = function(app, server) {
  // Используем setupMiddlewares для новой версии webpack-dev-server
  if (app.get && typeof app.use === 'function') {
    // Получаем порт из переменной окружения, .env.local файла или используем 8000 по умолчанию
    let backendPort = process.env.REACT_APP_API_PORT || 8000;
    
    // Пробуем прочитать из .env.local файла
    try {
      const envLocalPath = path.join(__dirname, '..', '.env.local');
      if (fs.existsSync(envLocalPath)) {
        const envContent = fs.readFileSync(envLocalPath, 'utf8');
        const portMatch = envContent.match(/REACT_APP_API_PORT=(\d+)/);
        if (portMatch) {
          backendPort = parseInt(portMatch[1], 10);
        }
      }
    } catch (e) {
      console.warn('[setupProxy] Не удалось прочитать .env.local:', e.message);
    }
    
    const backendUrl = `http://localhost:${backendPort}`;
    
    console.log(`[setupProxy] Настройка прокси на ${backendUrl} (порт из ${process.env.REACT_APP_API_PORT ? 'env' : '.env.local или default'})`);
    
    // Proxy для обычных HTTP запросов
    const apiProxy = createProxyMiddleware({
      target: backendUrl,
      changeOrigin: true,
      secure: false,
      ws: true,  // Включаем поддержку WebSocket
      logLevel: process.env.NODE_ENV === 'development' ? 'debug' : 'warn',
      onProxyReq: (proxyReq, req, res) => {
        if (process.env.NODE_ENV === 'development') {
          console.log(`[setupProxy] Проксирование ${req.method} ${req.url} -> ${backendUrl}${req.url}`);
        }
      },
      onProxyReqWs: (proxyReq, req, socket) => {
        console.log('[setupProxy] WebSocket проксирование:', req.url, '->', backendUrl);
      },
      onProxyRes: (proxyRes, req, res) => {
        // Убираем ограничения CORS для WebSocket upgrade
        if (req.headers.upgrade === 'websocket') {
          proxyRes.headers['upgrade'] = 'websocket';
          proxyRes.headers['connection'] = 'upgrade';
        }
      },
      onError: (err, req, res) => {
        console.error('[setupProxy] Ошибка прокси:', err.message);
        console.error(`[setupProxy] Проверьте, что backend запущен на порту ${backendPort}`);
        if (res && !res.headersSent) {
          res.status(500).json({
            error: 'Ошибка подключения к backend',
            message: `Не удалось подключиться к backend на порту ${backendPort}. Проверьте, что сервер запущен.`,
            backendUrl: backendUrl
          });
        }
      }
    });
    
    app.use('/api', apiProxy);
    
    // Настраиваем WebSocket прокси для сервера
    if (server) {
      server.on('upgrade', (request, socket, head) => {
        // Проксируем только запросы к /api
        // Исключаем /ws - это webpack-dev-server для hot reload
        if (request.url && request.url.startsWith('/api')) {
          try {
            apiProxy.upgrade(request, socket, head);
          } catch (err) {
            // Игнорируем ошибки, если сокет уже закрыт
            if (err.code !== 'ERR_STREAM_WRITE_AFTER_END' && err.code !== 'ECONNRESET') {
              console.error('[setupProxy] Ошибка при проксировании WebSocket:', err.message);
            }
            // Не пытаемся закрыть уже закрытый сокет
            if (!socket.destroyed) {
              try {
                socket.destroy();
              } catch (e) {
                // Игнорируем ошибки при закрытии
              }
            }
          }
        } else if (request.url && (request.url === '/ws' || request.url.startsWith('/ws?'))) {
          // /ws используется webpack-dev-server для hot reload - не проксируем
          // Просто игнорируем, webpack-dev-server обработает сам
          return;
        } else {
          // Для других WebSocket запросов закрываем соединение
          if (!socket.destroyed) {
            try {
              socket.destroy();
            } catch (e) {
              // Игнорируем ошибки при закрытии
            }
          }
        }
      });
    }
  }
};

