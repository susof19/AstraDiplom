# Dockerfile для создания образа Linux с TigerVNC и noVNC
# Поддерживает Debian-based дистрибутивы (Debian, Ubuntu, Astra Linux)

ARG BASE_IMAGE=debian:12
FROM ${BASE_IMAGE}

# Метаданные
LABEL maintainer="Linux Training Simulator"
LABEL description="Linux sandbox with TigerVNC and noVNC for web-based GUI access"
LABEL version="1.0"

# Переменные окружения
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=ru_RU.UTF-8 \
    LANGUAGE=ru_RU:ru \
    LC_ALL=ru_RU.UTF-8 \
    DISPLAY=:0 \
    VNC_PORT=5900 \
    NOVNC_PORT=6080 \
    VNC_RESOLUTION=1280x720 \
    VNC_DEPTH=24

# Установка базовых пакетов и локалей
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        wget \
        curl \
        gnupg2 \
        apt-transport-https && \
    echo "ru_RU.UTF-8 UTF-8" >> /etc/locale.gen && \
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen && \
    update-locale LANG=ru_RU.UTF-8

# Установка минимального набора пакетов (доступных в базовом образе)
RUN apt-get install -y --no-install-recommends \
        dbus-x11 \
        x11-xserver-utils \
        x11-utils \
        xterm \
        supervisor \
        net-tools \
        procps \
        vim \
        nano \
        htop || true && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Попытка установить XFCE (если доступен)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        xfce4 \
        xfce4-terminal || \
    echo "XFCE недоступен, используем базовый X11" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установка TigerVNC (если доступен) или альтернативы
RUN apt-get update && \
    (apt-get install -y --no-install-recommends \
        tigervnc-standalone-server \
        tigervnc-common || true) && \
    (apt-get install -y --no-install-recommends \
        tightvncserver || true) && \
    (apt-get install -y --no-install-recommends \
        x11vnc || true) && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установка Python3 и зависимостей для noVNC
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-numpy \
        git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# noVNC + websockify (из git, без pip)
RUN git clone --depth 1 https://github.com/novnc/noVNC.git /opt/noVNC && \
    git clone --depth 1 https://github.com/novnc/websockify.git /opt/noVNC/utils/websockify && \
    ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html && \
    chmod +x /opt/noVNC/utils/novnc_proxy


# Создание пользователя для VNC
RUN useradd -m -s /bin/bash -G sudo sandboxuser && \
    echo "sandboxuser:sandbox123" | chpasswd && \
    mkdir -p /home/sandboxuser/.vnc && \
    mkdir -p /home/sandboxuser/.config/xfce4 && \
    chown -R sandboxuser:sandboxuser /home/sandboxuser

# Настройка VNC пароля
USER sandboxuser
# Создаем VNC пароль используя x11vnc (самый надежный способ)
RUN mkdir -p /home/sandboxuser/.vnc && \
    (x11vnc -storepasswd sandbox123 /home/sandboxuser/.vnc/passwd 2>/dev/null || \
     echo "sandbox123" | vncpasswd -f > /home/sandboxuser/.vnc/passwd 2>/dev/null || \
     echo "sandbox123" | tightvncpasswd -f > /home/sandboxuser/.vnc/passwd 2>/dev/null || \
     # Если ничего не работает, создаем пустой файл (VNC сервер может работать без пароля или установить позже)
     touch /home/sandboxuser/.vnc/passwd) && \
    chmod 600 /home/sandboxuser/.vnc/passwd

# Создание конфигурации VNC
RUN echo '#!/bin/bash' > /home/sandboxuser/.vnc/xstartup && \
    echo 'unset SESSION_MANAGER' >> /home/sandboxuser/.vnc/xstartup && \
    echo 'unset DBUS_SESSION_BUS_ADDRESS' >> /home/sandboxuser/.vnc/xstartup && \
    echo 'export XKL_XMODMAP_DISABLE=1' >> /home/sandboxuser/.vnc/xstartup && \
    echo 'export XDG_CURRENT_DESKTOP=XFCE' >> /home/sandboxuser/.vnc/xstartup && \
    echo 'export XDG_SESSION_TYPE=x11' >> /home/sandboxuser/.vnc/xstartup && \
    echo 'dbus-launch --exit-with-session startxfce4 &' >> /home/sandboxuser/.vnc/xstartup && \
    chmod +x /home/sandboxuser/.vnc/xstartup

# Создание конфигурации XFCE (отключение заставки и энергосбережения)
RUN mkdir -p /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml && \
    echo '<?xml version="1.0" encoding="UTF-8"?>' > /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '<channel name="xfce4-power-manager" version="1.0">' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '  <property name="xfce4-power-manager" type="empty">' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '    <property name="dpms-enabled" type="bool" value="false"/>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '    <property name="blank-on-ac" type="int" value="0"/>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '  </property>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '</channel>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml

USER root

# Создание скрипта запуска VNC
COPY images/start-vnc.sh /usr/local/bin/start-vnc.sh
RUN chmod +x /usr/local/bin/start-vnc.sh

# Создание конфигурации supervisor
RUN mkdir -p /var/log/supervisor && \
    mkdir -p /etc/supervisor/conf.d

COPY images/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Открытие портов
EXPOSE 5900 6080

# Создание директории для миссий
RUN mkdir -p /mission && \
    chown sandboxuser:sandboxuser /mission

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:6080/ || exit 1

# Точка входа
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

