# Dockerfile для создания образа Linux с TigerVNC и noVNC
# Универсальный для Debian-based дистрибутивов (Debian, Ubuntu, Astra Linux)
# 
# Использование:
#   docker build -f images/Dockerfile.gui-vnc --build-arg BASE_IMAGE=debian:12 -t localhost/linux-gui-vnc:debian .
#   docker build -f images/Dockerfile.gui-vnc --build-arg BASE_IMAGE=ubuntu:22.04 -t localhost/linux-gui-vnc:ubuntu .
#   docker build -f images/Dockerfile.gui-vnc --build-arg BASE_IMAGE=astra-linux:se -t localhost/linux-gui-vnc:astra .

ARG BASE_IMAGE=debian:12
FROM ${BASE_IMAGE}

# Метаданные
LABEL maintainer="Linux Training Simulator"
LABEL description="Linux sandbox with TigerVNC and noVNC for web-based GUI access"
LABEL version="1.0"

# Переменные окружения
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=ru_RU.UTF-8 \
    LANGUAGE=ru_RU:ru \
    LC_ALL=ru_RU.UTF-8 \
    DISPLAY=:0 \
    VNC_PORT=5900 \
    NOVNC_PORT=6080 \
    VNC_RESOLUTION=1280x720 \
    VNC_DEPTH=24

# Установка базовых пакетов и локалей
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        wget \
        curl \
        gnupg2 \
        apt-transport-https && \
    echo "ru_RU.UTF-8 UTF-8" >> /etc/locale.gen && \
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen && \
    update-locale LANG=ru_RU.UTF-8

# Установка минимального набора пакетов (доступных в базовом образе)
RUN apt-get install -y --no-install-recommends \
        dbus-x11 \
        x11-xserver-utils \
        x11-utils \
        xterm \
        supervisor \
        net-tools \
        procps \
        vim \
        nano \
        htop || true && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Попытка установить XFCE (если доступен)
# Устанавливаем полный набор XFCE компонентов для нормальной работы
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        xfce4 \
        xfce4-goodies \
        xfce4-terminal \
        xfce4-panel \
        xfce4-session \
        xfwm4 \
        xfdesktop4 \
        xfce4-settings \
        thunar \
        desktop-base \
        xfce4-notifyd || \
    echo "XFCE недоступен, используем базовый X11" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установка TigerVNC (если доступен) или альтернативы
RUN apt-get update && \
    (apt-get install -y --no-install-recommends \
        tigervnc-standalone-server \
        tigervnc-common || true) && \
    (apt-get install -y --no-install-recommends \
        tightvncserver || true) && \
    (apt-get install -y --no-install-recommends \
        x11vnc || true) && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установка Python3 и git для noVNC
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-minimal \
        git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установка noVNC + websockify (из git, без pip)
# noVNC официально поддерживает такой способ, pip не нужен
RUN git clone --depth 1 https://github.com/novnc/noVNC.git /opt/noVNC && \
    git clone --depth 1 https://github.com/novnc/websockify.git /opt/noVNC/utils/websockify && \
    ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html && \
    chmod +x /opt/noVNC/utils/novnc_proxy

# Создание пользователя для VNC
RUN useradd -m -s /bin/bash -G sudo sandboxuser && \
    echo "sandboxuser:sandbox123" | chpasswd && \
    mkdir -p /home/sandboxuser/.vnc && \
    mkdir -p /home/sandboxuser/.config/xfce4 && \
    chown -R sandboxuser:sandboxuser /home/sandboxuser

# Настройка VNC пароля
USER sandboxuser
# Создаем VNC пароль используя x11vnc (самый надежный способ)
RUN mkdir -p /home/sandboxuser/.vnc && \
    (x11vnc -storepasswd sandbox123 /home/sandboxuser/.vnc/passwd 2>/dev/null || \
     echo "sandbox123" | vncpasswd -f > /home/sandboxuser/.vnc/passwd 2>/dev/null || \
     echo "sandbox123" | tightvncpasswd -f > /home/sandboxuser/.vnc/passwd 2>/dev/null || \
     # Если ничего не работает, создаем пустой файл (VNC сервер может работать без пароля или установить позже)
     touch /home/sandboxuser/.vnc/passwd) && \
    chmod 600 /home/sandboxuser/.vnc/passwd

# Создание конфигурации VNC xstartup скрипта
# Более надежный способ запуска XFCE в VNC
RUN cat > /home/sandboxuser/.vnc/xstartup << 'EOFSTARTUP'
#!/bin/bash
# XFCE Desktop Environment startup script for VNC

# Очистка переменных окружения сессии
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

# Настройка переменных окружения
export XKL_XMODMAP_DISABLE=1
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_TYPE=x11
export XDG_MENU_PREFIX=xfce-
export XDG_CONFIG_DIRS=/etc/xdg/xfce4:/etc/xdg
export XDG_DATA_DIRS=/usr/share/xfce4:/usr/share/xfce:/usr/local/share:/usr/share

# Загрузка X ресурсов
[ -r $HOME/.Xresources ] && xrdb $HOME/.Xresources 2>/dev/null

# Запуск dbus если доступен (важно для XFCE)
if command -v dbus-launch >/dev/null 2>&1; then
    eval $(dbus-launch --sh-syntax --exit-with-session 2>/dev/null)
    export DBUS_SESSION_BUS_ADDRESS
fi

# Запуск XFCE Desktop Environment
# Важно: запускаем процессы в фоне, но скрипт должен оставаться активным
# VNC будет держать сессию пока работает X сервер

# Запуск XFCE сессии в фоне
if command -v startxfce4 >/dev/null 2>&1; then
    echo "Запуск XFCE Desktop Environment..."
    startxfce4 &
    XFCE_PID=$!
elif command -v xfce4-session >/dev/null 2>&1; then
    echo "Запуск XFCE Session..."
    xfce4-session &
    XFCE_PID=$!
else
    # Fallback: запускаем компоненты XFCE по отдельности
    echo "Запуск компонентов XFCE по отдельности..."
    
    # Запуск оконного менеджера
    if command -v xfwm4 >/dev/null 2>&1; then
        xfwm4 --replace &
    fi
    
    # Запуск панели
    if command -v xfce4-panel >/dev/null 2>&1; then
        xfce4-panel &
    fi
    
    # Запуск рабочего стола
    if command -v xfdesktop >/dev/null 2>&1; then
        xfdesktop &
    elif command -v xfdesktop4 >/dev/null 2>&1; then
        xfdesktop4 &
    fi
    
    # Запуск менеджера настроек (опционально)
    # xfce4-settings &
    
    XFCE_PID=0
fi

# Если ничего не найдено, запускаем хотя бы терминал
if [ "$XFCE_PID" = "0" ] || ! ps -p "$XFCE_PID" >/dev/null 2>&1; then
    echo "XFCE не найден, запускаем базовый терминал..."
    if command -v xterm >/dev/null 2>&1; then
        xterm -geometry 80x24+10+10 -ls -title "Desktop" &
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        x-terminal-emulator &
    fi
fi

# Держим скрипт активным, отслеживая XFCE процесс
# Это важно для VNC - если скрипт завершится сразу, сессия может не запуститься
if [ "$XFCE_PID" != "0" ] && ps -p "$XFCE_PID" >/dev/null 2>&1; then
    wait $XFCE_PID
else
    # Если процесс не найден, просто ждем (процессы запущены в фоне)
    wait
fi
EOFSTARTUP
RUN chmod +x /home/sandboxuser/.vnc/xstartup

# Создание конфигурации XFCE (отключение заставки и энергосбережения)
RUN mkdir -p /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml && \
    echo '<?xml version="1.0" encoding="UTF-8"?>' > /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '<channel name="xfce4-power-manager" version="1.0">' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '  <property name="xfce4-power-manager" type="empty">' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '    <property name="dpms-enabled" type="bool" value="false"/>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '    <property name="blank-on-ac" type="int" value="0"/>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '  </property>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml && \
    echo '</channel>' >> /home/sandboxuser/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml

USER root

# Создание скрипта запуска VNC
COPY images/start-vnc.sh /usr/local/bin/start-vnc.sh
RUN chmod +x /usr/local/bin/start-vnc.sh

# Создание конфигурации supervisor
RUN mkdir -p /var/log/supervisor && \
    mkdir -p /etc/supervisor/conf.d && \
    # Удаляем все старые конфигурации supervisor (если есть)
    rm -f /etc/supervisor/conf.d/*.conf && \
    # Удаляем системную конфигурацию supervisor (если есть)
    rm -f /etc/supervisor/supervisord.conf 2>/dev/null || true

COPY images/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Открытие портов
EXPOSE 5900 6080

# Создание директории для миссий
RUN mkdir -p /mission && \
    chown sandboxuser:sandboxuser /mission

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:6080/ || exit 1

# Создание главного файла конфигурации supervisor (если его нет)
RUN if [ ! -f /etc/supervisor/supervisord.conf ]; then \
        echo '[supervisord]' > /etc/supervisor/supervisord.conf && \
        echo 'nodaemon=true' >> /etc/supervisor/supervisord.conf && \
        echo 'user=root' >> /etc/supervisor/supervisord.conf && \
        echo 'logfile=/var/log/supervisor/supervisord.log' >> /etc/supervisor/supervisord.conf && \
        echo 'pidfile=/var/run/supervisord.pid' >> /etc/supervisor/supervisord.conf && \
        echo 'childlogdir=/var/log/supervisor' >> /etc/supervisor/supervisord.conf && \
        echo '' >> /etc/supervisor/supervisord.conf && \
        echo '[include]' >> /etc/supervisor/supervisord.conf && \
        echo 'files = /etc/supervisor/conf.d/*.conf' >> /etc/supervisor/supervisord.conf; \
    fi

# Точка входа
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]

